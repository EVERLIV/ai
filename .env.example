# Пример переменных окружения. Скопируйте в .env и подставьте значения.
# Файл .env в git не попадает (см. .gitignore).

# --- Фронтенд (Vite). Эти значения публичные — попадают в браузер. ---
VITE_SUPABASE_URL=https://api.arendacity.com
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-ключ Supabase>
VITE_YANDEX_MAPS_API_KEY=<ключ Яндекс.Карт>
# Опционально: URL edge-функции уведомлений (по умолчанию cloud-проект)
# VITE_NOTIFY_LEAD_URL=https://xbdwapunrlnxcuxjhaca.supabase.co/functions/v1/notify-lead

# --- Серверные секреты. НИКОГДА не добавляйте к ним префикс VITE_: ---
# переменные с VITE_ попадают в JS-бандл и видны любому посетителю сайта.
#
# Эти переменные читает edge-функция ai-chat на сервере (Deno.env.get),
# а не фронтенд. Задавать их нужно на VPS — см. docs/SETUP_ANTHROPIC_KEY.md.
ANTHROPIC_API_KEY=sk-ant-api03-<ваш-ключ>
SUPABASE_SERVICE_ROLE_KEY=<service_role-ключ Supabase>

# Cloud Edge Function notify-lead (секреты в Dashboard, не в .env фронта):
# TELEGRAM_BOT_TOKEN=<токен от BotFather>
# TELEGRAM_CHAT_ID=<id группы, например -1001234567890>
# см. docs/SETUP_TELEGRAM_LEADS.md
