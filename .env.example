# Пример переменных окружения. Скопируйте в .env и подставьте значения.
# Файл .env в git не попадает (см. .gitignore).

# --- Фронтенд (Vite). Эти значения публичные — попадают в браузер. ---
VITE_SUPABASE_URL=https://api.arendacity.com
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-ключ Supabase>
VITE_YANDEX_MAPS_API_KEY=<ключ Яндекс.Карт>
# Cloudflare Turnstile — защита форм (см. docs/SETUP_TURNSTILE.md)
# VITE_TURNSTILE_SITE_KEY=<site key>

# Edge functions на VDS (по умолчанию берутся из VITE_SUPABASE_URL):
# VITE_SUBMIT_LEAD_URL=https://api.arendacity.com/functions/v1/submit-lead
# VITE_CHAT_API_URL=https://api.arendacity.com/functions/v1/ai-chat
# VITE_LISTING_AI_URL=https://api.arendacity.com/functions/v1/ai-listing-create
# VITE_PROPERTY_PICK_API_URL=https://api.arendacity.com/functions/v1/ai-property-pick
# VITE_NOTIFY_LEAD_URL=https://api.arendacity.com/functions/v1/notify-lead
# VITE_NOTIFY_PROPERTY_EMAIL_URL=https://api.arendacity.com/functions/v1/notify-property-email
# VITE_SEND_AGENCY_INVITE_URL=https://api.arendacity.com/functions/v1/send-agency-invite
# VITE_TRACK_PROPERTY_VIEW_URL=https://api.arendacity.com/functions/v1/track-property-view
# VITE_ELEVENLABS_TOKEN_URL=https://api.arendacity.com/functions/v1/elevenlabs-conversation-token

# --- Серверные секреты. НИКОГДА не добавляйте к ним префикс VITE_: ---
# переменные с VITE_ попадают в JS-бандл и видны любому посетителю сайта.
#
# Эти переменные читает edge-функция ai-chat на сервере (Deno.env.get),
# а не фронтенд. Задавать их нужно на VPS — см. docs/SETUP_ANTHROPIC_KEY.md.
ANTHROPIC_API_KEY=sk-ant-api03-<ваш-ключ>
SUPABASE_SERVICE_ROLE_KEY=<service_role-ключ Supabase>

# Edge Function secrets (VPS /opt/supabase/volumes/functions/.env):
# TURNSTILE_SECRET_KEY=<secret key Cloudflare Turnstile>
# TELEGRAM_BOT_TOKEN=<токен от BotFather>
# TELEGRAM_CHAT_ID=<id группы, например -1001234567890>
# CATALOG_URL=https://api.arendacity.com
# CATALOG_ANON_KEY=<anon-ключ Supabase>
# см. docs/SETUP_TELEGRAM_LEADS.md

# Agency Telegram bot (отдельный бот для агентств):
# AGENCY_TELEGRAM_BOT_TOKEN=...
# AGENCY_TELEGRAM_WEBHOOK_SECRET=...
# AGENCY_NOTIFY_INTERNAL_SECRET=...
# см. docs/SETUP_AGENCY_TELEGRAM_BOT.md
# VITE_AGENCY_BOT_USERNAME=ArendaCityAgencyBot
